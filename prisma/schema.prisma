generator client { provider = "prisma-client" output = "../src/generated/prisma" }
datasource db { provider = "sqlite" }
model Organization { id String @id @default(uuid()) name String industry String timeZone String defaultBudgetCents Int defaultApprovalThresholdCents Int users User[] worksites Worksite[] workers Worker[] shifts Shift[] policies PolicyConfiguration? audits AuditEvent[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model User { id String @id @default(uuid()) organizationId String organization Organization @relation(fields:[organizationId],references:[id]) name String email String @unique role String active Boolean @default(true) createdAt DateTime @default(now()) }
model Worksite { id String @id @default(uuid()) organizationId String organization Organization @relation(fields:[organizationId],references:[id]) name String address String latitude Float longitude Float timeZone String active Boolean @default(true) shifts Shift[] }
model Worker { id String @id @default(uuid()) organizationId String organization Organization @relation(fields:[organizationId],references:[id]) name String phone String? email String? pickupAddress String latitude Float longitude Float reliabilityScore Int active Boolean @default(true) mock Boolean @default(true) qualifications WorkerQualification[] evaluations CandidateEvaluation[] }
model Qualification { id String @id @default(uuid()) name String @unique description String expirationRequired Boolean workers WorkerQualification[] }
model WorkerQualification { workerId String qualificationId String worker Worker @relation(fields:[workerId],references:[id]) qualification Qualification @relation(fields:[qualificationId],references:[id]) verified Boolean effectiveAt DateTime expiresAt DateTime? @@id([workerId,qualificationId]) }
model Shift { id String @id @default(uuid()) organizationId String organization Organization @relation(fields:[organizationId],references:[id]) worksiteId String worksite Worksite @relation(fields:[worksiteId],references:[id]) roleName String startsAt DateTime endsAt DateTime requiredArrivalAt DateTime status String calloutReason String? budgetCents Int approvalThresholdCents Int rescue RescueCase? }
model RescueCase { id String @id @default(uuid()) shiftId String @unique shift Shift @relation(fields:[shiftId],references:[id]) currentState String version Int @default(0) priority String selectedWorkerId String? agentConfidence Float? startedAt DateTime @default(now()) completedAt DateTime? failureReason String? evaluations CandidateEvaluation[] approvals ApprovalRequest[] authorizations PaymentAuthorization[] bookings TransportationBooking[] audits AuditEvent[] operations IdempotencyRecord[] }
model CandidateEvaluation { id String @id @default(uuid()) rescueCaseId String rescueCase RescueCase @relation(fields:[rescueCaseId],references:[id]) workerId String worker Worker @relation(fields:[workerId],references:[id]) eligible Boolean score Int rank Int? explanation String exclusionReason String? @@unique([rescueCaseId,workerId]) }
model ApprovalRequest { id String @id @default(uuid()) rescueCaseId String rescueCase RescueCase @relation(fields:[rescueCaseId],references:[id]) reason String amountCents Int currency String @default("USD") status String createdAt DateTime @default(now()) resolvedAt DateTime? resolutionNote String? }
model PaymentAuthorization { id String @id @default(uuid()) rescueCaseId String rescueCase RescueCase @relation(fields:[rescueCaseId],references:[id]) provider String externalReference String? authorizedCents Int currency String @default("USD") idempotencyKey String @unique status String mock Boolean @default(true) expiresAt DateTime transactions PaymentTransaction[] }
model PaymentTransaction { id String @id @default(uuid()) authorizationId String authorization PaymentAuthorization @relation(fields:[authorizationId],references:[id]) externalReference String? merchant String amountCents Int currency String status String receiptReference String? createdAt DateTime @default(now()) }
model TransportationBooking { id String @id @default(uuid()) rescueCaseId String rescueCase RescueCase @relation(fields:[rescueCaseId],references:[id]) provider String externalReference String? idempotencyKey String @unique pickupAddress String destinationAddress String estimatedArrival DateTime bookingStatus String mock Boolean @default(true) actualArrival DateTime? }
model AuditEvent { id String @id @default(uuid()) organizationId String organization Organization @relation(fields:[organizationId],references:[id]) rescueCaseId String? rescueCase RescueCase? @relation(fields:[rescueCaseId],references:[id]) sequence Int action String actorType String actorId String? previousState String? newState String? summary String correlationId String createdAt DateTime @default(now()) @@unique([rescueCaseId,sequence]) }
model IdempotencyRecord { id String @id @default(uuid()) rescueCaseId String rescueCase RescueCase @relation(fields:[rescueCaseId],references:[id]) operationType String idempotencyKey String responseJson String status String createdAt DateTime @default(now()) @@unique([rescueCaseId,operationType,idempotencyKey]) }
model PolicyConfiguration { organizationId String @id organization Organization @relation(fields:[organizationId],references:[id]) maximumCents Int approvalThresholdCents Int maximumLatenessMinutes Int allowedProviders String retryLimit Int confidenceThreshold Float }
