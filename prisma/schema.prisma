generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id                       String               @id @default(uuid())
  name                     String
  industry                 String
  timeZone                 String
  defaultBudgetCents       Int
  defaultApprovalThreshold Int
  rescueCases              RescueCase[]
  auditEvents              AuditEvent[]
  policy                   PolicyConfiguration?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
}

model RescueCase {
  id                     String                 @id @default(uuid())
  organizationId         String
  organization           Organization           @relation(fields: [organizationId], references: [id])
  shiftReference         String
  roleName               String
  currentState           String
  scenario               String
  version                Int                    @default(0)
  selectedWorker         String?
  selectedOption         String?
  approvalStatus         String                 @default("PENDING")
  paymentStatus          String                 @default("NOT_REQUESTED")
  bookingStatus          String                 @default("NOT_REQUESTED")
  authorizedCents        Int?
  spentCents             Int?
  startedAt              DateTime               @default(now())
  completedAt            DateTime?
  auditEvents            AuditEvent[]
  idempotencyRecords     IdempotencyRecord[]
  approvalRequests       ApprovalRequest[]
  paymentAuthorizations  PaymentAuthorization[]
  transportationBookings TransportationBooking[]

  @@index([organizationId, currentState])
}

model ApprovalRequest {
  id           String     @id @default(uuid())
  rescueCaseId String
  rescueCase   RescueCase @relation(fields: [rescueCaseId], references: [id])
  amountCents  Int
  reason       String
  status       String
  resolvedBy   String?
  resolvedAt   DateTime?
  note         String?
  createdAt    DateTime   @default(now())
}

model PaymentAuthorization {
  id                String     @id @default(uuid())
  rescueCaseId      String
  rescueCase        RescueCase @relation(fields: [rescueCaseId], references: [id])
  idempotencyKey    String     @unique
  provider          String
  providerMode      String
  externalReference String?
  authorizedCents   Int
  status            String
  expiresAt         DateTime?
  createdAt         DateTime   @default(now())
}

model TransportationBooking {
  id                String     @id @default(uuid())
  rescueCaseId      String
  rescueCase        RescueCase @relation(fields: [rescueCaseId], references: [id])
  idempotencyKey    String     @unique
  provider          String
  providerMode      String
  externalReference String?
  status            String
  estimatedArrival  DateTime?
  actualArrival     DateTime?
  createdAt         DateTime   @default(now())
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  rescueCaseId   String
  rescueCase     RescueCase   @relation(fields: [rescueCaseId], references: [id])
  sequence       Int
  actorType      String
  actorId        String?
  action         String
  previousState  String?
  newState       String?
  policyResult   String?
  approvalStatus String?
  summary        String
  correlationId  String
  operationKey   String
  createdAt      DateTime     @default(now())

  @@unique([rescueCaseId, sequence])
  @@index([organizationId, createdAt])
}

model IdempotencyRecord {
  id             String     @id @default(uuid())
  rescueCaseId   String
  rescueCase     RescueCase @relation(fields: [rescueCaseId], references: [id])
  operationType  String
  idempotencyKey String
  responseJson   String
  status         String
  createdAt      DateTime   @default(now())

  @@unique([rescueCaseId, operationType, idempotencyKey])
}

model PolicyConfiguration {
  organizationId          String       @id
  organization            Organization @relation(fields: [organizationId], references: [id])
  maximumCents            Int
  approvalThresholdCents  Int
  maximumLatenessMinutes  Int
  allowedProvidersJson    String
  retryLimit              Int
  confidenceThreshold     Float
}
